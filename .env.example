# ============================================================================
# SmartPlan — Environment Variables
# Copy this file to `.env.local` for dev, and paste the same keys into Vercel
# Project Settings → Environment Variables (Production + Preview).
# All values are placeholders; replace with real values from the provisioning
# checklist in docs/SETUP.md.
# ============================================================================

# ---- Supabase (server + client) -------------------------------------------
SUPABASE_URL=__PLACEHOLDER__
SUPABASE_ANON_KEY=__PLACEHOLDER__
SUPABASE_SERVICE_ROLE_KEY=__PLACEHOLDER__
SUPABASE_DB_PASSWORD=__PLACEHOLDER__

# Frontend-only mirrors (Vite requires VITE_ prefix to expose to client bundle)
VITE_SUPABASE_URL=__PLACEHOLDER__
VITE_SUPABASE_ANON_KEY=__PLACEHOLDER__

# ---- AI providers (BACKEND ONLY — never expose with VITE_ prefix) ---------
# §3.13 Multi-key rotation: either GEMINI_API_KEY (single) or
# GEMINI_API_KEYS (comma-separated). Same for GROQ.
GEMINI_API_KEY=__PLACEHOLDER__
# GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEY=__PLACEHOLDER__
# GROQ_API_KEYS=key1,key2

# ---- Firebase (web SDK — safe to expose; FCM server key is backend-only) ---
VITE_FIREBASE_API_KEY=__PLACEHOLDER__
VITE_FIREBASE_AUTH_DOMAIN=__PLACEHOLDER__
VITE_FIREBASE_PROJECT_ID=__PLACEHOLDER__
VITE_FIREBASE_STORAGE_BUCKET=__PLACEHOLDER__
VITE_FIREBASE_APP_ID=__PLACEHOLDER__
VITE_FIREBASE_MESSAGING_SENDER_ID=__PLACEHOLDER__
VITE_FIREBASE_VAPID_KEY=__PLACEHOLDER__

# Server-side FCM HTTP v1 (service account fields — paste from JSON key)
FIREBASE_PROJECT_ID=__PLACEHOLDER__
FIREBASE_CLIENT_EMAIL=__PLACEHOLDER__
FIREBASE_PRIVATE_KEY=__PLACEHOLDER__

# ---- Cron dispatcher (Supabase Edge → Vercel internal endpoints) -----------
# Shared secret used in x-cron-secret header. Set the same value in Supabase
# Edge Function env (cron-poller) AND Vercel env.
CRON_SECRET=__PLACEHOLDER__
# Full base URL for cron-poller to call internal Vercel endpoints
APP_BASE_URL=__PLACEHOLDER__

# ---- Google OAuth (configured in Supabase Auth dashboard) ------------------
# These do NOT need to be set as env vars in the app; they live in the
# Supabase project settings. Listed here for the provisioning checklist only.
# GOOGLE_OAUTH_CLIENT_ID=__PLACEHOLDER__
# GOOGLE_OAUTH_CLIENT_SECRET=__PLACEHOLDER__
